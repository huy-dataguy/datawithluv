---
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
---

<Layout title="Tools | Quoc Huy's Blog" description="Personal utility tools collection">
  <Main pageTitle="Tools" pageDesc="Bộ công cụ cá nhân. Các tool chạy hoàn toàn trên trình duyệt, không upload dữ liệu lên server.">
    <div class="tools-grid">
      <a href="/tools/paint" class="tool-card">
        <div class="tool-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18.37 2.63a2.12 2.12 0 0 1 3 3L14 13l-4 1 1-4Z"/><path d="M9 15c-3 1-5.5 1-6 3.5S6 22 8 20c1-1 1-4 1-5Z"/></svg>
        </div>
        <div class="tool-info">
          <h3>Paint</h3>
          <p>Paste ảnh, vẽ, thêm text, blur vùng chọn, copy kết quả.</p>
        </div>
      </a>
      <a href="/tools/pdf-editor" class="tool-card">
        <div class="tool-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><polyline points="14 2 14 8 20 8"/><path d="m9 15 2 2 4-4"/></svg>
        </div>
        <div class="tool-info">
          <h3>PDF Editor</h3>
          <p>Upload PDF, highlight, vẽ, thêm note, comment, bôi màu, save kết quả.</p>
        </div>
      </a>
      <a href="/tools/watermark" class="tool-card">
        <div class="tool-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        </div>
        <div class="tool-info">
          <h3>Watermark</h3>
          <p>Gắn logo lên ảnh, chỉnh kích thước, độ trong suốt, kéo thả vị trí, tải về.</p>
        </div>
      </a>
    </div>
  </Main>
</Layout>

<style>
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .tool-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: 0.75rem;
    border: 1px solid var(--border);
    background: var(--surface, #fff);
    text-decoration: none;
    color: var(--foreground);
    transition: all 0.15s;
  }

  .tool-card:hover {
    border-color: var(--accent);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--accent) 15%, transparent);
    transform: translateY(-1px);
  }

  .tool-icon {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tool-info h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .tool-info p {
    font-size: 0.8rem;
    color: var(--foreground-muted, #888);
    line-height: 1.4;
  }
</style>
