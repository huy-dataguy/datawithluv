---
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
---

<Layout title="PDF Editor | Quoc Huy's Blog" description="Upload and annotate PDF files with highlights, drawings, notes, and comments">
  <Main pageTitle="PDF Editor" pageDesc="Upload PDF, annotate with highlights, drawings, text, notes, then save the result.">
    <!-- Upload State -->
    <div id="upload-area">
      <div class="upload-box" id="upload-box">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><polyline points="14 2 14 8 20 8"/><line x1="12" x2="12" y1="18" y2="12"/><polyline points="9 15 12 12 15 15"/></svg>
        <p class="upload-title">Kéo thả file PDF vào đây</p>
        <p class="upload-sub">hoặc click để chọn file</p>
        <input type="file" id="pdf-upload" accept=".pdf,application/pdf" class="sr-only" />
      </div>
    </div>

    <!-- Editor State -->
    <div id="editor-area">
      <!-- Toolbar -->
      <div class="toolbar">
        <div class="tool-group">
          <button class="tool-btn active" data-tool="highlight" title="Highlight (H)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 11-6 6v3h9l3-3"/><path d="m22 12-4.6 4.6a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8L14 4"/></svg>
          </button>
          <button class="tool-btn" data-tool="pen" title="Pen (P)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.37 2.63a2.12 2.12 0 0 1 3 3L14 13l-4 1 1-4Z"/><path d="M9 15c-3 1-5.5 1-6 3.5S6 22 8 20c1-1 1-4 1-5Z"/></svg>
          </button>
          <button class="tool-btn" data-tool="rectangle" title="Rectangle (R)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
          </button>
          <button class="tool-btn" data-tool="circle" title="Circle (C)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
          </button>
          <button class="tool-btn" data-tool="arrow" title="Arrow (A)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="19" x2="19" y2="5"/><polyline points="12 5 19 5 19 12"/></svg>
          </button>
          <button class="tool-btn" data-tool="text" title="Text (T)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" x2="15" y1="20" y2="20"/><line x1="12" x2="12" y1="4" y2="20"/></svg>
          </button>
          <button class="tool-btn" data-tool="note" title="Note (N)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 15h7v6"/></svg>
          </button>
          <button class="tool-btn" data-tool="eraser" title="Eraser (E)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 21-4.3-4.3c-1-1-1-2.5 0-3.4l9.6-9.6c1-1 2.5-1 3.4 0l5.6 5.6c1 1 1 2.5 0 3.4L13 21"/><path d="M22 21H7"/><path d="m5 11 9 9"/></svg>
          </button>
        </div>

        <div class="sep"></div>

        <div class="color-group">
          <button class="color-dot active" data-color="#fde047" style="background:#fde047" title="Yellow"></button>
          <button class="color-dot" data-color="#ef4444" style="background:#ef4444" title="Red"></button>
          <button class="color-dot" data-color="#3b82f6" style="background:#3b82f6" title="Blue"></button>
          <button class="color-dot" data-color="#22c55e" style="background:#22c55e" title="Green"></button>
          <button class="color-dot" data-color="#f97316" style="background:#f97316" title="Orange"></button>
          <button class="color-dot" data-color="#ec4899" style="background:#ec4899" title="Pink"></button>
          <button class="color-dot" data-color="#000000" style="background:#000000" title="Black"></button>
          <label class="custom-color">
            <input type="color" id="color-picker" value="#fde047" />
          </label>
        </div>

        <div class="sep"></div>

        <div class="size-group">
          <span id="brush-size-label">3px</span>
          <input type="range" id="brush-size" min="1" max="30" value="3" />
        </div>

        <div class="sep"></div>

        <div class="opacity-group">
          <span id="opacity-label">40%</span>
          <input type="range" id="opacity-slider" min="10" max="100" value="40" />
        </div>
      </div>

      <!-- Action Bar -->
      <div class="action-bar">
        <label class="action-btn" title="Upload new PDF">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg>
          <span>PDF mới</span>
          <input type="file" id="pdf-reupload" accept=".pdf,application/pdf" class="sr-only" />
        </label>
        <button class="action-btn" id="btn-undo" title="Undo (Ctrl+Z)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/></svg>
          <span>Undo</span>
        </button>
        <button class="action-btn" id="btn-redo" title="Redo (Ctrl+Shift+Z)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 7v6h-6"/><path d="M3 17a9 9 0 0 1 9-9 9 9 0 0 1 6 2.3L21 13"/></svg>
          <span>Redo</span>
        </button>
        <button class="action-btn danger" id="btn-clear" title="Clear page annotations">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
          <span>Xoá trang</span>
        </button>

        <div class="action-spacer"></div>

        <span id="page-info" class="page-info">1 / 1</span>

        <div class="sep"></div>

        <div class="zoom-group">
          <button class="action-btn" id="btn-zoom-out" title="Zoom out">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/><line x1="8" x2="14" y1="11" y2="11"/></svg>
          </button>
          <span id="zoom-label" class="zoom-label">100%</span>
          <button class="action-btn" id="btn-zoom-in" title="Zoom in">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/><line x1="11" x2="11" y1="8" y2="14"/><line x1="8" x2="14" y1="11" y2="11"/></svg>
          </button>
        </div>

        <div class="sep"></div>

        <button class="primary-btn" id="btn-save" title="Save annotated PDF">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          Save PDF
        </button>
      </div>

      <!-- Canvas Viewport -->
      <div class="canvas-viewport" id="canvas-viewport">
        <div id="pages-inner"></div>
      </div>

      <input type="text" id="text-input" style="display:none" />
      <input type="text" id="note-input" style="display:none" />
    </div>
  </Main>
</Layout>

<style>
  :global(#upload-area) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
  }

  .upload-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 3rem 4rem;
    border-radius: 1rem;
    border: 2px dashed var(--border);
    background: var(--surface, #fff);
    cursor: pointer;
    transition: all 0.2s;
    color: var(--foreground-muted, #888);
    position: relative;
  }

  .upload-box:hover,
  .upload-box.drag-over {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 5%, transparent);
    color: var(--accent);
  }

  .upload-title {
    font-size: 1rem;
    font-weight: 500;
    color: var(--foreground);
  }

  .upload-sub {
    font-size: 0.8rem;
    color: var(--foreground-muted, #888);
  }

  :global(#editor-area) {
    display: none;
    flex-direction: column;
    gap: 0.5rem;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    background: var(--surface, #fff);
  }

  .tool-group { display: flex; gap: 2px; }

  .tool-btn {
    padding: 0.4rem;
    border-radius: 0.375rem;
    border: none;
    background: transparent;
    color: var(--foreground);
    cursor: pointer;
    transition: all 0.12s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tool-btn:hover { background: color-mix(in srgb, var(--foreground) 10%, transparent); }
  .tool-btn.active { background: var(--accent); color: white; }
  .tool-btn.active svg { stroke: white; }

  .sep { width: 1px; height: 1.5rem; background: var(--border); flex-shrink: 0; }

  .color-group { display: flex; align-items: center; gap: 3px; }

  .color-dot {
    width: 22px; height: 22px; border-radius: 50%;
    border: 2px solid transparent; cursor: pointer;
    transition: all 0.12s; padding: 0;
  }

  .color-dot:hover { transform: scale(1.15); }
  .color-dot.active {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .custom-color input[type="color"] {
    width: 22px; height: 22px; border-radius: 0.25rem;
    border: 1px solid var(--border); padding: 0; cursor: pointer; background: transparent;
  }

  .size-group, .opacity-group { display: flex; align-items: center; gap: 0.375rem; }
  .size-group span, .opacity-group span { font-size: 0.7rem; color: var(--foreground-muted, #888); min-width: 2rem; text-align: right; }
  .size-group input[type="range"], .opacity-group input[type="range"] { width: 4rem; }

  .action-bar {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem;
    padding: 0.375rem 0.75rem; border-radius: 0.5rem;
    border: 1px solid var(--border); background: var(--surface, #fff);
  }

  .action-btn {
    display: flex; align-items: center; gap: 0.3rem; padding: 0.35rem 0.5rem;
    border-radius: 0.375rem; border: none; background: transparent;
    color: var(--foreground); cursor: pointer; font-size: 0.75rem;
    transition: all 0.12s; white-space: nowrap;
  }

  .action-btn span { font-size: 0.7rem; }
  .action-btn:hover { background: color-mix(in srgb, var(--foreground) 10%, transparent); }
  .action-btn.danger:hover { background: color-mix(in srgb, #ef4444 15%, transparent); color: #ef4444; }
  .action-btn.danger:hover svg { stroke: #ef4444; }
  .action-spacer { flex: 1; }

  .page-info { font-size: 0.75rem; font-weight: 500; color: var(--foreground-muted, #888); }

  .zoom-group { display: flex; align-items: center; gap: 0.125rem; }
  .zoom-label { font-size: 0.7rem; color: var(--foreground-muted, #888); min-width: 2.5rem; text-align: center; }

  .primary-btn {
    display: flex; align-items: center; gap: 0.3rem; padding: 0.35rem 0.75rem;
    border-radius: 0.375rem; border: none; font-size: 0.75rem; font-weight: 500;
    cursor: pointer; transition: all 0.12s; white-space: nowrap;
    background: var(--accent); color: white;
  }

  .primary-btn svg { stroke: white; }
  .primary-btn:hover { opacity: 0.9; }
  .primary-btn.saving { background: #22c55e; pointer-events: none; }

  .canvas-viewport {
    overflow: auto;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--foreground) 5%, transparent);
    flex: 1;
    min-height: 400px;
    position: relative;
  }

  #pages-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
  }

  .page-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .page-label {
    font-size: 0.7rem;
    color: var(--foreground-muted, #888);
    padding: 0.25rem 0 0.375rem;
  }

  .page-canvas-wrap {
    position: relative;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
    border-radius: 2px;
  }

  .page-canvas-wrap .pdf-canvas { display: block; }

  .page-canvas-wrap .annot-canvas {
    position: absolute;
    top: 0;
    left: 0;
    cursor: crosshair;
  }

  #text-input, #note-input {
    position: absolute;
    z-index: 10;
    outline: none;
    font-family: var(--font-inter, sans-serif);
    padding: 2px 0;
  }

  #text-input { background: transparent; border-bottom: 2px solid var(--accent); min-width: 80px; }
  #note-input { border: 1px solid var(--accent); border-radius: 3px; padding: 4px 6px; font-size: 13px; min-width: 120px; }

  @media (max-width: 640px) {
    .action-btn span { display: none; }
    .toolbar { gap: 0.375rem; padding: 0.375rem 0.5rem; }
    .action-bar { padding: 0.25rem 0.5rem; }
    .upload-box { padding: 2rem; }
  }
</style>

<script>
  // @ts-nocheck
  function loadScript(src: string) {
    return new Promise<void>((resolve, reject) => {
      const s = document.createElement("script");
      s.src = src;
      s.onload = () => resolve();
      s.onerror = reject;
      document.head.appendChild(s);
    });
  }

  await loadScript("https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js");
  await loadScript("https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js");

  const pdfjsLib = (window as any).pdfjsLib;
  const PDFLib = (window as any).PDFLib;

  {

  var pdfDoc = null;
  var pdfBytes = null;
  var totalPages = 0;
  var activePageNum = 0;
  var zoom = 1;
  var MAX_SCALE = 2.0;

  var currentTool = "highlight";
  var color = "#fde047";
  var brushSize = 3;
  var opacity = 0.4;
  var drawing = false;
  var startX = 0, startY = 0, currentX = 0, currentY = 0;

  var activeAnnotCtx = null;
  var pageHistory = {};

  var uploadArea = document.getElementById("upload-area");
  var editorArea = document.getElementById("editor-area");
  var uploadBox = document.getElementById("upload-box");
  var viewport = document.getElementById("canvas-viewport");
  var pagesInner = document.getElementById("pages-inner");
  var fileInput = document.getElementById("pdf-upload");
  var reuploadInput = document.getElementById("pdf-reupload");
  var textInput = document.getElementById("text-input");
  var noteInput = document.getElementById("note-input");

  pdfjsLib.GlobalWorkerOptions.workerSrc = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";

  function getAnnotCanvas(pageNum) {
    var wrapper = pagesInner.querySelector('[data-page="' + pageNum + '"]');
    return wrapper ? wrapper.querySelector(".annot-canvas") : null;
  }

  function getAnnotCtx(pageNum) {
    var c = getAnnotCanvas(pageNum);
    return c ? c.getContext("2d") : null;
  }

  // === Load PDF ===
  async function loadPDF(file) {
    var buffer = await file.arrayBuffer();
    pdfBytes = new Uint8Array(buffer);
    pdfDoc = await pdfjsLib.getDocument({ data: pdfBytes.slice() }).promise;
    totalPages = pdfDoc.numPages;
    activePageNum = 1;
    pageHistory = {};

    uploadArea.style.display = "none";
    editorArea.style.display = "flex";
    pagesInner.innerHTML = "";

    for (var i = 1; i <= totalPages; i++) {
      var wrapper = document.createElement("div");
      wrapper.className = "page-wrapper";
      wrapper.dataset.page = i;

      var label = document.createElement("div");
      label.className = "page-label";
      label.textContent = "Trang " + i;

      var canvasWrap = document.createElement("div");
      canvasWrap.className = "page-canvas-wrap";

      var pdfC = document.createElement("canvas");
      pdfC.className = "pdf-canvas";

      var annotC = document.createElement("canvas");
      annotC.className = "annot-canvas";

      canvasWrap.appendChild(pdfC);
      canvasWrap.appendChild(annotC);
      wrapper.appendChild(label);
      wrapper.appendChild(canvasWrap);
      pagesInner.appendChild(wrapper);

      var page = await pdfDoc.getPage(i);
      var baseVP = page.getViewport({ scale: 1 });
      var containerWidth = viewport.clientWidth - 48;
      var scale = Math.min(containerWidth / baseVP.width, MAX_SCALE);
      var vp = page.getViewport({ scale: scale });
      pdfC.width = vp.width;
      pdfC.height = vp.height;
      annotC.width = vp.width;
      annotC.height = vp.height;
      canvasWrap.style.width = vp.width + "px";
      canvasWrap.style.height = vp.height + "px";

      await page.render({ canvasContext: pdfC.getContext("2d"), viewport: vp }).promise;

      var ctx = annotC.getContext("2d");
      var imgData = ctx.getImageData(0, 0, vp.width, vp.height);
      pageHistory[i] = { stack: [imgData], idx: 0 };
    }

    updatePageInfo();
    setZoom(zoom);
  }

  // === History ===
  function pushHistory() {
    if (!activeAnnotCtx) return;
    var canvas = activeAnnotCtx.canvas;
    var h = pageHistory[activePageNum];
    if (!h) return;
    var data = activeAnnotCtx.getImageData(0, 0, canvas.width, canvas.height);
    h.stack = h.stack.slice(0, h.idx + 1);
    h.stack.push(data);
    h.idx = h.stack.length - 1;
  }

  function restoreLast() {
    var h = pageHistory[activePageNum];
    if (!h || !h.stack[h.idx]) return;
    var last = h.stack[h.idx];
    activeAnnotCtx.putImageData(last, 0, 0);
  }

  function undo() {
    var h = pageHistory[activePageNum];
    if (!h || h.idx <= 0) return;
    h.idx--;
    activeAnnotCtx.putImageData(h.stack[h.idx], 0, 0);
  }

  function redo() {
    var h = pageHistory[activePageNum];
    if (!h || h.idx >= h.stack.length - 1) return;
    h.idx++;
    activeAnnotCtx.putImageData(h.stack[h.idx], 0, 0);
  }

  // === Page Info (scroll-based) ===
  function updatePageInfo() {
    var info = document.getElementById("page-info");
    info.textContent = activePageNum + " / " + totalPages;
  }

  viewport.addEventListener("scroll", function() {
    var wrappers = pagesInner.querySelectorAll(".page-wrapper");
    var midY = viewport.getBoundingClientRect().top + viewport.clientHeight / 2;
    for (var i = 0; i < wrappers.length; i++) {
      var rect = wrappers[i].getBoundingClientRect();
      if (rect.top <= midY && rect.bottom >= midY) {
        if (activePageNum !== i + 1) {
          activePageNum = i + 1;
          activeAnnotCtx = getAnnotCtx(activePageNum);
          updatePageInfo();
        }
        break;
      }
    }
  });

  // === Zoom ===
  function setZoom(z) {
    zoom = Math.max(0.25, Math.min(3, z));
    pagesInner.style.zoom = zoom;
    document.getElementById("zoom-label").textContent = Math.round(zoom * 100) + "%";
  }

  // === Drawing ===
  function getPos(e, canvas) {
    var rect = canvas.getBoundingClientRect();
    var scaleX = canvas.width / rect.width;
    var scaleY = canvas.height / rect.height;
    var clientX = e.touches ? e.touches[0].clientX : e.clientX;
    var clientY = e.touches ? e.touches[0].clientY : e.clientY;
    return { x: (clientX - rect.left) * scaleX, y: (clientY - rect.top) * scaleY };
  }

  function isLightColor(hex) {
    var r = parseInt(hex.slice(1, 3), 16);
    var g = parseInt(hex.slice(3, 5), 16);
    var b = parseInt(hex.slice(5, 7), 16);
    return (r * 0.299 + g * 0.587 + b * 0.114) > 128;
  }

  function drawHighlightPreview() {
    restoreLast();
    activeAnnotCtx.save();
    activeAnnotCtx.globalAlpha = opacity;
    activeAnnotCtx.fillStyle = color;
    activeAnnotCtx.fillRect(
      Math.min(startX, currentX), Math.min(startY, currentY),
      Math.abs(currentX - startX), Math.abs(currentY - startY)
    );
    activeAnnotCtx.restore();
  }

  function drawShapePreview() {
    restoreLast();
    activeAnnotCtx.strokeStyle = color;
    activeAnnotCtx.lineWidth = brushSize;
    activeAnnotCtx.lineCap = "round";
    activeAnnotCtx.lineJoin = "round";
    activeAnnotCtx.beginPath();
    if (currentTool === "rectangle") {
      activeAnnotCtx.rect(startX, startY, currentX - startX, currentY - startY);
      activeAnnotCtx.stroke();
    } else if (currentTool === "circle") {
      var rx = Math.abs(currentX - startX) / 2;
      var ry = Math.abs(currentY - startY) / 2;
      activeAnnotCtx.ellipse(startX + (currentX - startX) / 2, startY + (currentY - startY) / 2, rx, ry, 0, 0, Math.PI * 2);
      activeAnnotCtx.stroke();
    } else if (currentTool === "arrow") {
      activeAnnotCtx.moveTo(startX, startY);
      activeAnnotCtx.lineTo(currentX, currentY);
      activeAnnotCtx.stroke();
      var headlen = 12 + brushSize;
      var angle = Math.atan2(currentY - startY, currentX - startX);
      activeAnnotCtx.beginPath();
      activeAnnotCtx.moveTo(currentX, currentY);
      activeAnnotCtx.lineTo(currentX - headlen * Math.cos(angle - Math.PI / 6), currentY - headlen * Math.sin(angle - Math.PI / 6));
      activeAnnotCtx.lineTo(currentX - headlen * Math.cos(angle + Math.PI / 6), currentY - headlen * Math.sin(angle + Math.PI / 6));
      activeAnnotCtx.closePath();
      activeAnnotCtx.fillStyle = color;
      activeAnnotCtx.fill();
    }
  }

  function drawNote(x, y, text) {
    var fontSize = 14;
    var padding = 6;
    activeAnnotCtx.font = fontSize + "px Inter, sans-serif";
    var textW = activeAnnotCtx.measureText(text).width;
    var noteW = textW + padding * 2;
    var noteH = fontSize + padding * 2;

    activeAnnotCtx.fillStyle = "rgba(0,0,0,0.12)";
    activeAnnotCtx.fillRect(x + 2, y + 2, noteW, noteH);

    activeAnnotCtx.fillStyle = color;
    activeAnnotCtx.fillRect(x, y, noteW, noteH);

    activeAnnotCtx.fillStyle = "rgba(0,0,0,0.15)";
    activeAnnotCtx.beginPath();
    activeAnnotCtx.moveTo(x + noteW, y);
    activeAnnotCtx.lineTo(x + noteW - 10, y);
    activeAnnotCtx.lineTo(x + noteW, y + 10);
    activeAnnotCtx.closePath();
    activeAnnotCtx.fill();

    activeAnnotCtx.fillStyle = isLightColor(color) ? "#000" : "#fff";
    activeAnnotCtx.textBaseline = "top";
    activeAnnotCtx.fillText(text, x + padding, y + padding);
    activeAnnotCtx.textBaseline = "alphabetic";
    pushHistory();
  }

  // === Events (delegation) ===
  pagesInner.addEventListener("mousedown", function(e) {
    var canvas = e.target.closest(".annot-canvas");
    if (!canvas || !pdfDoc) return;
    if (textInput.style.display !== "none" || noteInput.style.display !== "none") return;

    var pageNum = parseInt(canvas.closest(".page-wrapper").dataset.page);
    activePageNum = pageNum;
    activeAnnotCtx = canvas.getContext("2d");
    updatePageInfo();

    e.preventDefault();
    var pos = getPos(e, canvas);

    if (currentTool === "text") { showTextInput(pos, canvas); return; }
    if (currentTool === "note") { showNoteInput(pos, canvas); return; }

    drawing = true;
    startX = pos.x; startY = pos.y;
    currentX = pos.x; currentY = pos.y;

    if (currentTool === "pen") {
      activeAnnotCtx.beginPath();
      activeAnnotCtx.moveTo(pos.x, pos.y);
      activeAnnotCtx.lineCap = "round";
      activeAnnotCtx.lineJoin = "round";
      activeAnnotCtx.strokeStyle = color;
      activeAnnotCtx.lineWidth = brushSize;
    } else if (currentTool === "eraser") {
      activeAnnotCtx.beginPath();
      activeAnnotCtx.moveTo(pos.x, pos.y);
      activeAnnotCtx.lineCap = "round";
      activeAnnotCtx.lineJoin = "round";
      activeAnnotCtx.globalCompositeOperation = "destination-out";
      activeAnnotCtx.strokeStyle = "rgba(0,0,0,1)";
      activeAnnotCtx.lineWidth = brushSize * 3;
    }
  });

  pagesInner.addEventListener("mousemove", function(e) {
    if (!drawing || !activeAnnotCtx) return;
    var canvas = activeAnnotCtx.canvas;
    var pos = getPos(e, canvas);
    currentX = pos.x; currentY = pos.y;

    if (currentTool === "pen" || currentTool === "eraser") {
      activeAnnotCtx.lineTo(pos.x, pos.y);
      activeAnnotCtx.stroke();
    } else if (currentTool === "highlight") {
      drawHighlightPreview();
    } else {
      drawShapePreview();
    }
  });

  function endDraw() {
    if (!drawing) return;
    drawing = false;
    if (currentTool === "pen") {
      activeAnnotCtx.closePath();
      pushHistory();
    } else if (currentTool === "eraser") {
      activeAnnotCtx.closePath();
      activeAnnotCtx.globalCompositeOperation = "source-over";
      pushHistory();
    } else if (currentTool === "highlight") {
      drawHighlightPreview();
      pushHistory();
    } else {
      restoreLast();
      drawShapePreview();
      pushHistory();
    }
  }

  document.addEventListener("mouseup", endDraw);

  pagesInner.addEventListener("touchstart", function(e) {
    var canvas = e.target.closest(".annot-canvas");
    if (!canvas || !pdfDoc) return;
    if (textInput.style.display !== "none" || noteInput.style.display !== "none") return;

    var pageNum = parseInt(canvas.closest(".page-wrapper").dataset.page);
    activePageNum = pageNum;
    activeAnnotCtx = canvas.getContext("2d");
    updatePageInfo();

    e.preventDefault();
    var pos = getPos(e, canvas);

    if (currentTool === "text") { showTextInput(pos, canvas); return; }
    if (currentTool === "note") { showNoteInput(pos, canvas); return; }

    drawing = true;
    startX = pos.x; startY = pos.y;
    currentX = pos.x; currentY = pos.y;

    if (currentTool === "pen") {
      activeAnnotCtx.beginPath();
      activeAnnotCtx.moveTo(pos.x, pos.y);
      activeAnnotCtx.lineCap = "round";
      activeAnnotCtx.lineJoin = "round";
      activeAnnotCtx.strokeStyle = color;
      activeAnnotCtx.lineWidth = brushSize;
    } else if (currentTool === "eraser") {
      activeAnnotCtx.beginPath();
      activeAnnotCtx.moveTo(pos.x, pos.y);
      activeAnnotCtx.lineCap = "round";
      activeAnnotCtx.lineJoin = "round";
      activeAnnotCtx.globalCompositeOperation = "destination-out";
      activeAnnotCtx.strokeStyle = "rgba(0,0,0,1)";
      activeAnnotCtx.lineWidth = brushSize * 3;
    }
  }, { passive: false });

  pagesInner.addEventListener("touchmove", function(e) {
    if (!drawing || !activeAnnotCtx) return;
    e.preventDefault();
    var canvas = activeAnnotCtx.canvas;
    var pos = getPos(e, canvas);
    currentX = pos.x; currentY = pos.y;

    if (currentTool === "pen" || currentTool === "eraser") {
      activeAnnotCtx.lineTo(pos.x, pos.y);
      activeAnnotCtx.stroke();
    } else if (currentTool === "highlight") {
      drawHighlightPreview();
    } else {
      drawShapePreview();
    }
  }, { passive: false });

  document.addEventListener("touchend", endDraw);

  // === Text Input ===
  function showTextInput(pos, canvas) {
    var rect = canvas.getBoundingClientRect();
    var vpRect = viewport.getBoundingClientRect();
    var scaleX = rect.width / canvas.width;
    var scaleY = rect.height / canvas.height;
    var fontSize = Math.max(16, brushSize * 6);

    textInput.style.display = "block";
    textInput.style.left = (rect.left - vpRect.left + pos.x * scaleX) + "px";
    textInput.style.top = (rect.top - vpRect.top + pos.y * scaleY) + "px";
    textInput.style.fontSize = (fontSize * scaleY) + "px";
    textInput.style.color = color;
    textInput.value = "";
    textInput.dataset.canvasX = String(pos.x);
    textInput.dataset.canvasY = String(pos.y);
    textInput.dataset.fontSize = String(fontSize);
    setTimeout(function() { textInput.focus(); }, 50);
  }

  function commitText() {
    var val = textInput.value.trim();
    if (val && activeAnnotCtx) {
      var fs = Number(textInput.dataset.fontSize) || 20;
      activeAnnotCtx.font = fs + "px Inter, sans-serif";
      activeAnnotCtx.fillStyle = color;
      activeAnnotCtx.textBaseline = "top";
      activeAnnotCtx.fillText(val, Number(textInput.dataset.canvasX), Number(textInput.dataset.canvasY));
      activeAnnotCtx.textBaseline = "alphabetic";
      pushHistory();
    }
    textInput.style.display = "none";
    textInput.value = "";
  }

  textInput.addEventListener("keydown", function(e) {
    if (e.key === "Enter") { e.preventDefault(); commitText(); }
    if (e.key === "Escape") { textInput.style.display = "none"; textInput.value = ""; }
  });
  textInput.addEventListener("blur", commitText);

  // === Note Input ===
  function showNoteInput(pos, canvas) {
    var rect = canvas.getBoundingClientRect();
    var vpRect = viewport.getBoundingClientRect();
    var scaleX = rect.width / canvas.width;
    var scaleY = rect.height / canvas.height;

    noteInput.style.display = "block";
    noteInput.style.left = (rect.left - vpRect.left + pos.x * scaleX) + "px";
    noteInput.style.top = (rect.top - vpRect.top + pos.y * scaleY) + "px";
    noteInput.style.background = color;
    noteInput.style.color = isLightColor(color) ? "#000" : "#fff";
    noteInput.value = "";
    noteInput.dataset.canvasX = String(pos.x);
    noteInput.dataset.canvasY = String(pos.y);
    setTimeout(function() { noteInput.focus(); }, 50);
  }

  function commitNote() {
    var val = noteInput.value.trim();
    if (val && activeAnnotCtx) {
      drawNote(Number(noteInput.dataset.canvasX), Number(noteInput.dataset.canvasY), val);
    }
    noteInput.style.display = "none";
    noteInput.value = "";
  }

  noteInput.addEventListener("keydown", function(e) {
    if (e.key === "Enter") { e.preventDefault(); commitNote(); }
    if (e.key === "Escape") { noteInput.style.display = "none"; noteInput.value = ""; }
  });
  noteInput.addEventListener("blur", commitNote);

  // === Tool/Color/Size/Opacity ===
  var toolBtns = document.querySelectorAll(".tool-btn");
  toolBtns.forEach(function(btn) {
    btn.addEventListener("click", function() {
      toolBtns.forEach(function(b) { b.classList.remove("active"); });
      btn.classList.add("active");
      currentTool = btn.dataset.tool;
      pagesInner.style.cursor = (currentTool === "text" || currentTool === "note") ? "text" : "crosshair";
    });
  });

  var colorDots = document.querySelectorAll(".color-dot");
  var colorPicker = document.getElementById("color-picker");

  function setColor(c) {
    color = c;
    colorDots.forEach(function(d) { d.classList.toggle("active", d.dataset.color === c); });
  }

  colorDots.forEach(function(dot) {
    dot.addEventListener("click", function() { setColor(dot.dataset.color); colorPicker.value = dot.dataset.color; });
  });

  colorPicker.addEventListener("input", function(e) {
    setColor(e.target.value);
    colorDots.forEach(function(d) { d.classList.remove("active"); });
  });

  var brushSizeInput = document.getElementById("brush-size");
  var brushSizeLabel = document.getElementById("brush-size-label");
  brushSizeInput.addEventListener("input", function(e) {
    brushSize = Number(e.target.value);
    brushSizeLabel.textContent = brushSize + "px";
  });

  var opacitySlider = document.getElementById("opacity-slider");
  var opacityLabel = document.getElementById("opacity-label");
  opacitySlider.addEventListener("input", function(e) {
    opacity = Number(e.target.value) / 100;
    opacityLabel.textContent = Math.round(opacity * 100) + "%";
  });

  // === Action Buttons ===
  document.getElementById("btn-undo").addEventListener("click", undo);
  document.getElementById("btn-redo").addEventListener("click", redo);

  document.getElementById("btn-clear").addEventListener("click", function() {
    if (!activeAnnotCtx) return;
    var c = activeAnnotCtx.canvas;
    activeAnnotCtx.clearRect(0, 0, c.width, c.height);
    pushHistory();
  });

  document.getElementById("btn-zoom-in").addEventListener("click", function() { setZoom(zoom + 0.25); });
  document.getElementById("btn-zoom-out").addEventListener("click", function() { setZoom(zoom - 0.25); });

  // === Save PDF ===
  async function savePDF() {
    var saveBtn = document.getElementById("btn-save");
    saveBtn.classList.add("saving");

    try {
      var pdfLibDoc = await PDFLib.PDFDocument.load(pdfBytes);

      for (var i = 1; i <= totalPages; i++) {
        var annotCanvas = getAnnotCanvas(i);
        if (!annotCanvas) continue;

        var annotCtx = annotCanvas.getContext("2d");
        var imgData = annotCtx.getImageData(0, 0, annotCanvas.width, annotCanvas.height);

        var hasPixels = false;
        var pixels = imgData.data;
        for (var p = 3; p < pixels.length; p += 16) {
          if (pixels[p] > 0) { hasPixels = true; break; }
        }
        if (!hasPixels) continue;

        var tempCanvas = document.createElement("canvas");
        tempCanvas.width = imgData.width;
        tempCanvas.height = imgData.height;
        tempCanvas.getContext("2d").putImageData(imgData, 0, 0);

        var flipCanvas = document.createElement("canvas");
        flipCanvas.width = imgData.width;
        flipCanvas.height = imgData.height;
        var flipCtx = flipCanvas.getContext("2d");
        flipCtx.translate(0, flipCanvas.height);
        flipCtx.scale(1, -1);
        flipCtx.drawImage(tempCanvas, 0, 0);

        var blob = await new Promise(function(resolve) {
          flipCanvas.toBlob(resolve, "image/png");
        });
        var pngBytes = new Uint8Array(await blob.arrayBuffer());

        var pngImage = await pdfLibDoc.embedPng(pngBytes);
        var page = pdfLibDoc.getPage(i - 1);
        var size = page.getSize();
        page.drawImage(pngImage, { x: 0, y: 0, width: size.width, height: size.height });
      }

      var modifiedBytes = await pdfLibDoc.save();
      var downloadBlob = new Blob([modifiedBytes], { type: "application/pdf" });
      var url = URL.createObjectURL(downloadBlob);
      var a = document.createElement("a");
      a.href = url;
      a.download = "annotated-" + Date.now() + ".pdf";
      a.click();
      URL.revokeObjectURL(url);
    } catch (err) {
      alert("Error saving PDF: " + err.message);
      console.error(err);
    }

    saveBtn.classList.remove("saving");
  }

  document.getElementById("btn-save").addEventListener("click", savePDF);

  // === File Upload ===
  uploadBox.addEventListener("click", function() { fileInput.click(); });

  fileInput.addEventListener("change", function() {
    var file = fileInput.files && fileInput.files[0];
    if (file) loadPDF(file);
    fileInput.value = "";
  });

  reuploadInput.addEventListener("change", function() {
    var file = reuploadInput.files && reuploadInput.files[0];
    if (file) { zoom = 1; setZoom(1); loadPDF(file); }
    reuploadInput.value = "";
  });

  uploadBox.addEventListener("dragover", function(e) {
    e.preventDefault();
    uploadBox.classList.add("drag-over");
  });
  uploadBox.addEventListener("dragleave", function() {
    uploadBox.classList.remove("drag-over");
  });
  uploadBox.addEventListener("drop", function(e) {
    e.preventDefault();
    uploadBox.classList.remove("drag-over");
    var file = e.dataTransfer.files[0];
    if (file && file.type === "application/pdf") loadPDF(file);
  });

  // === Keyboard ===
  document.addEventListener("keydown", function(e) {
    if (textInput.style.display !== "none" || noteInput.style.display !== "none") return;
    if ((e.ctrlKey || e.metaKey) && e.key === "z" && !e.shiftKey) {
      e.preventDefault(); undo();
    } else if ((e.ctrlKey || e.metaKey) && (e.key === "Z" || (e.key === "z" && e.shiftKey))) {
      e.preventDefault(); redo();
    } else if (!e.ctrlKey && !e.metaKey && !e.altKey) {
      var map = { h: "highlight", p: "pen", r: "rectangle", c: "circle", a: "arrow", t: "text", n: "note", e: "eraser" };
      var tool = map[e.key.toLowerCase()];
      if (tool) document.querySelector('[data-tool="' + tool + '"]')?.click();
    }
  });

}
</script>

