---
import { getCollection } from "astro:content";
import getSortedPosts from "@/utils/getSortedPosts";
import getUniqueTags from "@/utils/getUniqueTags";
import { slugifyStr } from "@/utils/slugify";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.slice(0, 5);
const tags = getUniqueTags(posts).slice(0, 12);
---

<aside class="w-full shrink-0 lg:w-64 xl:w-72">
  <!-- Recently Updated -->
  <div class="rounded-lg border border-border bg-surface p-4 mb-4">
    <h3 class="mb-3 text-sm font-bold uppercase tracking-widest text-accent">
      Recently Updated
    </h3>
    <ul class="space-y-2.5">
      {recentPosts.map(post => (
        <li>
          <a
            href={`/posts/${slugifyStr(post.id)}/`}
            class="block text-xs leading-snug text-muted-text transition-colors hover:text-accent line-clamp-2"
          >
            {post.data.title}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- Trending Tags -->
  <div class="rounded-lg border border-border bg-surface p-4">
    <h3 class="mb-3 text-sm font-bold uppercase tracking-widest text-accent">
      Trending Tags
    </h3>
    <div class="flex flex-wrap gap-2">
      {tags.map(({ tag, tagName }) => (
        <a
          href={`/tags/${tag}/`}
          class="inline-flex items-center rounded-full border border-border px-2.5 py-0.5 text-xs text-muted-text transition-all hover:border-accent/50 hover:text-accent hover:bg-accent/5"
        >
          #{tagName}
        </a>
      ))}
    </div>
  </div>
</aside>
