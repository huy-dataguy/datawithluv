---
import IconHash from "@/assets/icons/IconHash.svg";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  active?: boolean;
};

const { tag, tagName, size = "lg", active = false } = Astro.props;
---

<li>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class:list={[
      "inline-flex items-center gap-1 rounded-full border px-2.5 py-0.5 font-medium transition-all duration-150",
      // Default: neutral pill
      !active && "border-border text-muted-text hover:border-accent/50 hover:text-accent hover:bg-accent/5",
      // Active: amber filled pill
      active && "border-accent bg-accent/15 text-accent",
      { "text-sm": size === "sm" },
      { "text-base": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-60",
        { "size-3.5": size === "lg" },
        { "size-3": size === "sm" },
      ]}
    />
    {tagName}
  </a>
</li>
