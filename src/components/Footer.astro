---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class:list={[
      "py-6 sm:py-5",
      "border-t border-border",
      "flex flex-col items-center justify-between gap-3 sm:flex-row-reverse",
    ]}
  >
    <Socials />
    <div class="flex items-center gap-1.5 text-xs text-muted-text">
      <span>© {currentYear}</span>
      <span class="font-semibold text-accent">huy-dataguy</span>
      <span>· Built with <a href="https://github.com/satnaing/astro-paper" target="_blank" class="underline hover:text-accent">AstroPaper</a></span>
    </div>
  </div>
</footer>
