---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class:list={[
      "py-6 sm:py-5",
      "border-t border-border",
      "flex flex-col items-center justify-between sm:flex-row-reverse gap-3",
    ]}
  >
    <Socials />
    <div class="flex items-center gap-1.5 text-xs text-muted-text">
      <span>© {currentYear}</span>
      <span class="text-accent font-semibold">Huy.dev</span>
      <span>· Built with Astro</span>
    </div>
  </div>
</footer>
